config {
  # Doctype HTML5
  doctype = html5
  renderCharset = utf-8

  # Externalize CSS and JS
  removeDefaultCss = 0
  removeDefaultJS = 1

  # concatenate all Javascript files by default
  #concatenateJs = 1
  concatenateJs = 0
  # concatenate all CSS files by default
  #concatenateCss = 1
  concatenateCss = 0

  #Cache
  # clearAtMidnight deaktiviert (17.11.2026): wuerde cache_period auf den
  # naechsten Mitternachtspunkt kuerzen (CacheTimeout-Middleware).
  cache_clearAtMidnight = 0
  cache_period = 259200
  sendCacheHeaders = 1
  headerComment =

  spamProtectEmailAddresses = -3
  spamProtectEmailAddresses_atSubst = (at)
  spamProtectEmailAddresses_lastDotSubst = (dot)

  prefixLocalAnchors = all
  simulateStaticDocuments = 0

  meaningfulTempFilePrefix = 1

  # If set, the admin panel appears in the bottom of pages.
  admPanel = 0
}
